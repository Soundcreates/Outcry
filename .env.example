# Durable Match accounts and wallet joins use base Solana; private PER reads use MagicBlock TEE.
OUTCRY_BASE_RPC=https://api.devnet.solana.com
OUTCRY_DEPLOY_RPC=https://api.devnet.solana.com
OUTCRY_DEPLOY_TRANSPORT=quic
NEXT_PUBLIC_MAGICBLOCK_TEE_RPC=https://devnet-tee.magicblock.app
VITE_SOLANA_BASE_RPC=https://api.devnet.solana.com
VITE_OUTCRY_PROGRAM_ID=D2rYtfu8x3CxJ89YoAUrWbfiMGhFbAtE9Hq8RNoJaUZt
VITE_OUTCRY_MATCH_NONCE=2
VITE_MAGICBLOCK_TEE_RPC=https://devnet-tee.magicblock.app
VITE_MAGICBLOCK_ROUTER_RPC=https://devnet-router.magicblock.app

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=
OUTCRY_PROGRAM_ID=
OUTCRY_MATCH_ADDRESS=
OUTCRY_REDIS_URL=
# Absolute server-only keypair path. For Docker Compose this is mounted at
# /run/secrets/outcry-relayer-devnet.json.
OUTCRY_RELAYER_KEYPAIR_PATH=
# Separate server-only fee payer for delegated MagicBlock TEE transactions.
# Fund and delegate it to the configured TEE validator with the provisioning tool.
OUTCRY_TEE_RELAYER_KEYPAIR_PATH=
OUTCRY_RELAYER_RPC_URL=
# Router is authoritative for delegated runtime transaction routing.
OUTCRY_MAGICBLOCK_ROUTER_RPC=https://devnet-router.magicblock.app
# Optional MagicBlock validator identity; defaults to the documented devnet TEE validator.
OUTCRY_TEE_VALIDATOR=
